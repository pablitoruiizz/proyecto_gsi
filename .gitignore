# ========================================
# Qué SÍ versionar
# - Código fuente, configuración de ejemplo y documentación en Markdown
# - Plantillas sanitizadas (*.example, *.template, *.sample)
# ========================================

# ===== Sistema operativo / generales =====
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# ===== IDEs / editores =====
.vscode/
!.vscode/extensions.json
.idea/
*.iml

# ===== Variables de entorno y secretos =====
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.csr
id_rsa
id_rsa.pub
secrets.*

# ===== Logs =====
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
php_errorlog
error_log

# ===== Dependencias =====
node_modules/
vendor/

# ===== Archivos temporales / backups =====
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
*.save

# ===== Temporales documentación Office/PDF =====
~$*
*.asd
*.wbk
*.xlk
*.pptx.tmp
*.docx.tmp
*.xlsx.tmp
*.pdf.tmp

# ===== WordPress (contenido generado/local) =====
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/ai1wm-backups/
wp-content/advanced-cache.php
wp-content/object-cache.php
wp-content/debug.log
wp-content/backups/

# Configuración local sensible WordPress
wp-config.php
wp-config-local.php
wp-config-*.local.php

# ===== PHP / Composer =====
composer.phar
.phpunit.result.cache

# ===== Node (si aplica a herramientas front) =====
.npm/
.pnpm-store/
.yarn/
dist/
build/
coverage/

# ===== XAMPP / LAMP rutas y logs locales =====
xampp/
lampp/
/opt/lampp/
/Applications/XAMPP/
apache/logs/
mysql/data/
mysql/logs/

# ===== MySQL dumps y backups =====
*.sql
*.sql.gz
*.sql.zip
*.dump
*.dmp

# Excepciones permitidas para plantillas seguras/documentación
!**/*-template.sql
!**/*-example.sql
!**/docs/**/*.sql.md
# Excepción: volcados de bd_cadus SÍ se versionan para que todo el equipo
# trabaje sobre la misma base de datos.
# Revisar antes de cada commit que no contengan datos personales reales.
!cms-wordpress/backup-db/*.sql
# ===== Binarios y pesados no deseados =====
*.zip
*.tar
*.tar.gz
*.7z
*.rar

# Ignorar archivo de configuración local
wp-config.php

# Ignorar archivos subidos por medios (imágenes pesadas opcionales)
wp-content/uploads/
wp-content/cache/

# Ignorar logs locales
*.log
# Permitir subir ejemplos comprimidos ligeros y sanitizados si se necesitan
#!docs/ejemplos/*.zip
